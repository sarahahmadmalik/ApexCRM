# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# cached downloads for scripts/build-city-boundaries.ts
/.cache

# playwright MCP snapshots/screenshots from manual QA sessions
/.playwright-mcp
/*.png

# typescript
*.tsbuildinfo
next-env.d.ts

# --- Security: known supply-chain malware (PolinRider) drop points ---
# VS Code task/launch configs are a known injection vector for payloads that
# auto-execute on folder open (e.g. tasks.json with "runOn": "folderOpen").
.vscode/

# Git-history-rewriting propagation script observed in PolinRider-infected repos.
temp_auto_push.bat

# PolinRider hides JS payloads in fake .woff2 "font" files. This project
# doesn't ship real fonts from public/ (fonts come via @fontsource npm
# packages), so this is safe to ignore outright — narrow it if that changes.
public/fonts/*.woff2

# local backups of replaced live data
/supabase/backups

# --- IDE, editor and OS files ---
.idea/
*.iml
.vs/
*.swp
Thumbs.db
desktop.ini

# --- Build and tool caches ---
/.next/
/.swc
/.turbo
/.cache
.eslintcache
*.tsbuildinfo

# --- Playwright / browser-test output ---
/.playwright-mcp
/.playwright/
/playwright-report/
/test-results/
/blob-report/

# --- Screenshots and images dropped in the project root (assets belong in public/ or src/) ---
/*.png
/*.jpg
/*.jpeg
/*.gif
/*.webp
/*.bmp

# --- AI-assistant instruction files (generated by tooling, not part of the app) ---
/AGENTS.md
/CLAUDE.md
/.claude/

# --- Logs ---
*.log

# .env* above would also hide the example file people copy from
!.env.example
