# Supabase project settings — Project Settings -> API Keys in the Supabase dashboard.
# (Supabase's current key naming: "publishable key" replaces the old anon key,
# "secret key" replaces the old service_role key.)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Required for the Admin page (creating member logins, resetting passwords). Server only —
# it bypasses RLS, so never expose it to the browser or commit it.
SUPABASE_SECRET_KEY=
